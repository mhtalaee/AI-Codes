from openai import OpenAI
import numpy as np
client = OpenAI(api_key="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", base_url="https://openrouter.ai/api/v1")

def get_embedding(text, model="text-embedding-3-small"):
    response = client.embeddings.create(input=text, model=model)
    return response.data[0].embedding

def cosine_similarity(vec_a, vec_b):
    a = np.array(vec_a)
    b = np.array(vec_b)
    return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))


text1 = "هوش مصنوعی داره دنیا رو متحول می کنه"
text2 = "ماشین های هوشمند دارن زندگی بشر رو دگرگون می کنن"
text3 = "بهترین دستور پخت قورمه سبزی"

emb1 = get_embedding(text1)
emb2 = get_embedding(text2)
emb3 = get_embedding(text3)

print(f") شباهت متن ۱ و ۲ )مشابه : {cosine_similarity(emb1, emb2):.3f}") # عدد

print(f") شباهت متن ۱ و ۳ )متفاوت : {cosine_similarity(emb1, emb3):.3f}")